# Modelfile: Qwen3.6-35B-A3B, 32K context variant (Legion 5 Pro, 8GB VRAM/32GB RAM)
#
# Matches the Ollama Windows app's default Context length setting (32768),
# for consistent behavior between GUI chat sessions and API/agentic use.
# See tuning-results.md (peak ~85% RAM, +0.56GB over the 8K floor).

FROM qwen3.6:35b-a3b

PARAMETER num_ctx 32768
PARAMETER num_gpu 20
PARAMETER num_batch 256
PARAMETER num_thread 16

PARAMETER temperature 0.7
PARAMETER top_p 0.9
