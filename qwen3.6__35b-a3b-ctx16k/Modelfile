# Modelfile: Qwen3.6-35B-A3B, 16K context variant (Legion 5 Pro, 8GB VRAM/32GB RAM)
#
# See tuning-results.md for the measured RAM/VRAM cost at this context size
# (peak ~85% RAM, +0.40GB over the 8K floor). Base assumes model already
# pulled: `ollama pull qwen3.6:35b-a3b`.

FROM qwen3.6:35b-a3b

PARAMETER num_ctx 16384
PARAMETER num_gpu 20
PARAMETER num_batch 256
PARAMETER num_thread 16

PARAMETER temperature 0.7
PARAMETER top_p 0.9
