{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "ollama-y520": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (Legion Y520)",
      "options": {
        "baseURL": "{env:OLLAMA_BASE_URL}",
        "apiKey": "ollama",
        "timeout": 900000,
        "chunkTimeout": 900000
      },
      "models": {
        "gemma4:e4b-y520-agentic-32k": {
          "name": "Gemma 4 E4B Q4_K_M (32K, Y520 default)",
          "tool_call": true,
          "reasoning": false,
          "limit": { "context": 32768, "output": 1024 },
          "options": {
            "think": false,
            "num_ctx": 32768,
            "num_batch": 128,
            "num_thread": 4,
            "num_predict": 1024,
            "temperature": 1,
            "top_k": 64,
            "top_p": 0.95
          }
        },
        "gemma4:e4b-y520-agentic-32k-batch256": {
          "name": "Gemma 4 E4B Q4_K_M (32K, batch-256 speed test)",
          "tool_call": true,
          "reasoning": false,
          "limit": { "context": 32768, "output": 1024 },
          "options": {
            "think": false,
            "num_ctx": 32768,
            "num_batch": 256,
            "num_thread": 4,
            "num_predict": 1024,
            "temperature": 1,
            "top_k": 64,
            "top_p": 0.95
          }
        },
        "gemma4:e4b-y520-agentic-64k": {
          "name": "Gemma 4 E4B Q4_K_M (64K, experimental context)",
          "tool_call": true,
          "reasoning": false,
          "limit": { "context": 65536, "output": 1024 },
          "options": {
            "think": false,
            "num_ctx": 65536,
            "num_batch": 128,
            "num_thread": 4,
            "num_predict": 1024,
            "temperature": 1,
            "top_k": 64,
            "top_p": 0.95
          }
        }
      }
    }
  },

  "model": "ollama-y520/gemma4:e4b-y520-agentic-32k",

  "skills": {
    "paths": ["{env:OPENCODE_SKILLS_DIR}"]
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 2048
  }
}
