{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "qwen3.6:35b-a3b-64k-agentic": {
          "name": "Qwen3.6-35B-A3B (64K, agentic default)",
          // Default — chosen for prompt-processing speed (~244 tok/s vs
          // 128k-agentic's ~137 tok/s, measured — see docs/tuning-results.md,
          // "128K feasibility"). Matches
          // modelfiles/qwen3.6__35b-a3b-64k-agentic/Modelfile exactly
          // (num_ctx 65536, num_predict 16384).
          "limit": { "context": 65536, "output": 16384 }
        },
        "qwen3.6:35b-a3b-128k-agentic": {
          "name": "Qwen3.6-35B-A3B (128K, more context room)",
          // Switch to this mid-session via /model for long agentic
          // sessions or larger doc/code input — same RAM/VRAM footprint as
          // 64K (see docs/tuning-results.md, "128K feasibility"), just
          // slower prompt ingestion. Matches
          // modelfiles/qwen3.6__35b-a3b-128k-agentic/Modelfile exactly
          // (num_ctx 131072, num_predict 32768).
          //
          // 32k-standalone is intentionally NOT listed here — its window
          // can't fit opencode/Copilot's static tool overhead, so it's only
          // meant for `ollama run qwen3.6:35b-a3b-32k-standalone` directly.
          "limit": { "context": 131072, "output": 32768 }
        },
        "qwen3.5:9b-64k-agentic": {
          "name": "Qwen3.5-9B (dense, 64K, small/fast alternative)",
          // Switch to this via /model when you want the much smaller
          // footprint (7.6GB vs 22GB) for a quick tool-calling question,
          // not for heavy/long agentic sessions — qwen3.5:9b is DENSE
          // (not MoE), so it degrades harder than the 35B-A3B tiers once
          // it spills off GPU at this context size (measured: 22.3 vs
          // 36.6 gen tok/s at the same 64K context — see
          // docs/tuning-results.md, "qwen3.5:9b tuning"). Matches
          // modelfiles/qwen3.5__9b-64k-agentic/Modelfile exactly
          // (num_ctx 65536, num_predict 16384).
          //
          // 9b-12k-standalone is intentionally NOT listed here — same
          // reason as 32k-standalone above: its window can't fit
          // opencode/Copilot's static tool overhead, so it's only meant
          // for `ollama run qwen3.5:9b-12k-standalone` directly.
          "limit": { "context": 65536, "output": 16384 }
        }
      }
    }
  },

  "model": "ollama/qwen3.6:35b-a3b-64k-agentic",

  // Reuse the same quick/thorough SKILL.md files as Copilot CLI (see
  // configs/copilot/skills/) instead of duplicating them — opencode scans
  // any path here recursively for **/SKILL.md, same frontmatter format.
  // NOTE: this path is resolved relative to opencode's cwd at launch time,
  // not relative to this config file — bin/opencode-agentic sets it to an
  // absolute path via OPENCODE_SKILLS_DIR before exec'ing opencode so this
  // works regardless of which project directory you launch it from.
  "skills": {
    "paths": ["{env:OPENCODE_SKILLS_DIR}"]
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4096
  }
}
