{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://localhost:11434/v1" },
      "models": {
        "qwen3.6:35b-a3b-64k-agentic": {
          "name": "Qwen3.6-35B-A3B (64K, agentic default)",
          // Default — chosen for prompt-processing speed (~244 tok/s vs
          // 128k-agentic's ~137 tok/s, measured — see docs/tuning-results.md,
          // "128K feasibility"). Matches
          // modelfiles/qwen3.6__35b-a3b-64k-agentic/Modelfile exactly
          // (num_ctx 65536, num_predict 16384).
          "limit": { "context": 65536, "output": 16384 }
        },
        "qwen3.6:35b-a3b-128k-agentic": {
          "name": "Qwen3.6-35B-A3B (128K, more context room)",
          // Switch to this mid-session via /model for long agentic
          // sessions or larger doc/code input — same RAM/VRAM footprint as
          // 64K (see docs/tuning-results.md, "128K feasibility"), just
          // slower prompt ingestion. Matches
          // modelfiles/qwen3.6__35b-a3b-128k-agentic/Modelfile exactly
          // (num_ctx 131072, num_predict 32768).
          //
          // 32k-standalone is intentionally NOT listed here — its window
          // can't fit opencode/Copilot's static tool overhead, so it's only
          // meant for `ollama run qwen3.6:35b-a3b-32k-standalone` directly.
          "limit": { "context": 131072, "output": 32768 }
        },
        "qwen3.5:9b-32k-agentic": {
          "name": "Qwen3.5-9B (dense, 32K, small/fast alternative)",
          // opencode-only for this model (Copilot CLI support dropped —
          // its ~21.5K static overhead needs 64K+, which costs this dense
          // model too much speed to be worth it just for Copilot
          // compatibility). opencode's own static overhead is only
          // ~7,322 tokens, so 32K leaves plenty of headroom. Switch to
          // this via /model when you want the much smaller footprint
          // (6.7GB vs 22GB) or fastest speed for a quick tool-calling
          // question — not for heavy/long agentic sessions, where
          // qwen3.6:35b-a3b-*-agentic stays faster even while partially
          // CPU-offloaded (qwen3.5:9b is DENSE, not MoE, so it degrades
          // harder per context tier — see docs/tuning-results.md,
          // "qwen3.5:9b tuning"). Matches
          // modelfiles/qwen3.5__9b-32k-agentic/Modelfile exactly
          // (num_ctx 32768, num_predict 8192).
          //
          // 9b-12k-standalone is intentionally NOT listed here — same
          // reason as 32k-standalone above: its window can't fit
          // opencode's static tool overhead, so it's only meant for
          // `ollama run qwen3.5:9b-12k-standalone` directly.
          "limit": { "context": 32768, "output": 8192 }
        },
        "qwen3.5:9b-48k-agentic": {
          "name": "Qwen3.5-9B (dense, 48K, more context room)",
          // Switch to this mid-session via /model for a longer tool-use
          // session or more file context than 32k-agentic comfortably
          // holds — costs some speed (26.0 vs 29.5 gen tok/s measured,
          // see docs/tuning-results.md). Matches
          // modelfiles/qwen3.5__9b-48k-agentic/Modelfile exactly
          // (num_ctx 49152, num_predict 12288).
          "limit": { "context": 49152, "output": 12288 }
        },
        "qwen3.5:4b-32k-standalone": {
          "name": "Qwen3.5-4B (dense, 32K, closest small alt to 9B)",
          // Qwen3.5 has no official 7B/8B size (lineup is
          // 0.8B/2B/4B/9B/27B/35B/122B/397B-A17B) — 4B is the closest
          // smaller option below 9B. Same hybrid attention/SSM
          // architecture as 9B, just smaller (4.7B params). Not agentic-
          // tuned — see qwen3.5:4b-120k-agentic below for opencode/tool
          // use. This tier mirrors qwen3.5:9b-12k-standalone's role (plain
          // `ollama run` chat), just with a larger window since 4B stays
          // 100%-GPU-resident far longer than 9B (measured 100% GPU out to
          // ~127K context here, vs 9B's 13K cliff — see
          // docs/tuning-results.md, "qwen3.5:4b tuning"). Matches
          // modelfiles/qwen3.5__4b-32k-standalone/Modelfile exactly
          // (num_ctx 32768, num_predict 16384).
          "limit": { "context": 32768, "output": 16384 }
        },
        "qwen3.5:4b-120k-agentic": {
          "name": "Qwen3.5-4B (dense, 120K, fits + full speed)",
          // This is the tier that actually solves the problem
          // qwen3.5:9b-*-agentic couldn't: large agentic context AND
          // 100%-GPU-resident full speed at the same time. Measured
          // ~70.8 gen tok/s at 122,880 context (vs 9B's best-case 41.6 at
          // only 12-13K, or 29.5 at its 32K tier) — essentially double 9B
          // and faster than qwen3.6:35b-a3b's 65536-context 36.6 tok/s
          // too, because 4B never needs to CPU-offload at any size tested
          // here. Tradeoff: 4B is measurably less capable per-token than
          // 9B or 35b-a3b — pick this for quick/light tasks where speed +
          // headroom matter more than peak reasoning quality. No Copilot
          // CLI variant, same reasoning as the 9B tiers (its ~21.5K
          // static overhead vs opencode's ~7,322). Matches
          // modelfiles/qwen3.5__4b-120k-agentic/Modelfile exactly
          // (num_ctx 122880, num_predict 30720).
          "limit": { "context": 122880, "output": 30720 }
        },
        "gemma4:26b-64k-agentic": {
          "name": "Gemma4-26B-A4B (MoE, 64K, low-RAM alternative)",
          // Real MoE (25.2B total / 3.8B active + 1 shared expert) with
          // sliding-window attention, unlike qwen3.6:35b-a3b-64k-agentic's
          // 80%/20% CPU/GPU split which leaves only ~1.3GB free Windows
          // RAM at steady state. This model gets a 24%/76% CPU/GPU split
          // instead (~6.7GB free RAM), at the cost of some raw speed
          // (33-36 vs 46.6 gen tok/s) and a cold-start prompt-eval penalty
          // on the first call per session (~7.2 tok/s, then ~72.1 once
          // warmed — sparse experts lazy-load via mmap). Switch to this
          // via /model when RAM headroom matters more than peak speed
          // (e.g. Chrome/other apps open) — see docs/tuning-results.md,
          // "gemma4:26b tuning". Matches
          // modelfiles/gemma4__26b-64k-agentic/Modelfile exactly
          // (num_ctx 65536, num_predict 16384).
          "limit": { "context": 65536, "output": 16384 }
        }
      }
    }
  },

  "model": "ollama/qwen3.6:35b-a3b-64k-agentic",

  // Reuse the same quick/thorough SKILL.md files as Copilot CLI (see
  // configs/copilot/skills/) instead of duplicating them — opencode scans
  // any path here recursively for **/SKILL.md, same frontmatter format.
  // NOTE: this path is resolved relative to opencode's cwd at launch time,
  // not relative to this config file — bin/opencode-agentic sets it to an
  // absolute path via OPENCODE_SKILLS_DIR before exec'ing opencode so this
  // works regardless of which project directory you launch it from.
  "skills": {
    "paths": ["{env:OPENCODE_SKILLS_DIR}"]
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 4096
  }
}
