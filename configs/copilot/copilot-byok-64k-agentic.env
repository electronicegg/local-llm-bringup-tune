# Copilot CLI BYOK env for the local qwen3.6:35b-a3b-64k-agentic model.
# Usage:  source configs/copilot/copilot-byok-64k-agentic.env && copilot
#
# This is the only supported Copilot CLI config — 32k-standalone doesn't fit
# Copilot CLI's own static overhead (system prompt + all built-in tool
# schemas — bash, edit, view, grep, glob, task, plus the GitHub MCP server),
# measured at ~21,504 input tokens for a trivial "hi" prompt, *before* any
# real conversation. That's 65% of a 32K window by itself — not enough room
# left for conversation + output, which is what caused:
#   "Static system messages and tool definitions exceed the model's usable
#    context budget."
# 64K leaves ~44K after that static floor, which is workable.
#
# Values mirror modelfiles/legion5/qwen3.6__35b-a3b-64k-agentic/Modelfile exactly
# (num_ctx 65536, num_predict 16384) — update both together if you retune it.

export COPILOT_PROVIDER_BASE_URL="${COPILOT_PROVIDER_BASE_URL:-http://127.0.0.1:11434/v1}"
export COPILOT_PROVIDER_API_KEY=
export COPILOT_PROVIDER_WIRE_API=responses
export COPILOT_MODEL=qwen3.6:35b-a3b-64k-agentic

export COPILOT_PROVIDER_MAX_PROMPT_TOKENS=49152   # 65536 - 16384; covers ~21.5K static + growth room
export COPILOT_PROVIDER_MAX_OUTPUT_TOKENS=16384   # matches num_predict in the Modelfile
