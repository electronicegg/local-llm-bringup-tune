# Copilot CLI BYOK env for the local qwen3.5:9b-64k-agentic model.
# Usage:  source configs/copilot/copilot-byok-9b-64k-agentic.env && copilot
#
# Same static-overhead math as copilot-byok-64k-agentic.env (the
# qwen3.6:35b-a3b variant) — Copilot CLI's system prompt + built-in tool
# schemas + GitHub MCP server measure ~21,504 input tokens before any real
# conversation, so this needs the same 64K floor, not 32K.
#
# Use this instead of the 35B tiers when you want the much smaller
# footprint (7.6GB vs 22GB) or a second, independently-loadable model for
# quick tool-calling questions — NOT for heavy/long agentic sessions, where
# qwen3.6:35b-a3b-128k-agentic stays faster even while spilling to CPU
# (qwen3.5:9b is dense, so it degrades harder once it stops fitting fully
# in VRAM). See docs/tuning-results.md ("qwen3.5:9b tuning") for the
# measurements behind this.
#
# Values mirror modelfiles/qwen3.5__9b-64k-agentic/Modelfile exactly
# (num_ctx 65536, num_predict 16384) — update both together if retuned.

export COPILOT_PROVIDER_BASE_URL=http://127.0.0.1:11434/v1
export COPILOT_PROVIDER_API_KEY=
export COPILOT_PROVIDER_WIRE_API=responses
export COPILOT_MODEL=qwen3.5:9b-64k-agentic

export COPILOT_PROVIDER_MAX_PROMPT_TOKENS=49152   # 65536 - 16384; covers ~21.5K static + growth room
export COPILOT_PROVIDER_MAX_OUTPUT_TOKENS=16384   # matches num_predict in the Modelfile
