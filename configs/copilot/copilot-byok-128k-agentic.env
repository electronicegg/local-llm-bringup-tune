# Copilot CLI BYOK env for the local qwen3.6:35b-a3b-128k-agentic model —
# the default agentic tier (see bin/copilot-agentic).
# Usage:  source configs/copilot/copilot-byok-128k-agentic.env && copilot
#
# 128K measured at essentially the same host RAM/VRAM footprint as 64K,
# once the Modelfile's num_batch is dropped to 128 (fixes an auto-balancer
# regression that otherwise appears above ~64K context). See
# docs/tuning-results.md ("128K feasibility") for the measurements.
#
# Static system+tool overhead is the same ~21.5K tokens measured for
# Copilot CLI regardless of context size (bash/edit/view/grep/glob/task +
# GitHub MCP). 128K leaves ~106K after that floor — much more comfortable
# than 64K's ~44K, useful for long agentic sessions or larger doc/code
# context.
#
# Values mirror modelfiles/qwen3.6__35b-a3b-128k-agentic/Modelfile exactly
# (num_ctx 131072, num_predict 32768) — update both together if you retune it.

export COPILOT_PROVIDER_BASE_URL=http://127.0.0.1:11434/v1
export COPILOT_PROVIDER_API_KEY=
export COPILOT_PROVIDER_WIRE_API=responses
export COPILOT_MODEL=qwen3.6:35b-a3b-128k-agentic

export COPILOT_PROVIDER_MAX_PROMPT_TOKENS=98304   # 131072 - 32768; covers ~21.5K static + growth room
export COPILOT_PROVIDER_MAX_OUTPUT_TOKENS=32768   # matches num_predict in the Modelfile
