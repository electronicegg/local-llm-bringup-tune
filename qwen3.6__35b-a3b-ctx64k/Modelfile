# Modelfile: Qwen3.6-35B-A3B, 64K context variant (Legion 5 Pro, 8GB VRAM/32GB RAM)
#
# Recommended sweet spot per tuning-results.md: peak ~87% RAM, only +0.99GB
# over the 8K floor despite 8x more context — best choice for long chats,
# RAG chunks, or multi-file coding context via API/agentic use.

FROM qwen3.6:35b-a3b

PARAMETER num_ctx 65536
PARAMETER num_gpu 20
PARAMETER num_batch 256
PARAMETER num_thread 16

PARAMETER temperature 0.7
PARAMETER top_p 0.9
