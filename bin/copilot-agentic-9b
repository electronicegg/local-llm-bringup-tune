#!/usr/bin/env bash
# bin/copilot-agentic-9b — launches Copilot CLI wired to the local
# qwen3.5:9b-64k-agentic model via BYOK — the small/fast dense-model
# alternative to bin/copilot-agentic (qwen3.6:35b-a3b, MoE).
#
# Use this when you want the much smaller footprint (7.6GB vs 22GB) for a
# quick tool-calling session, not for heavy/long agentic work — qwen3.5:9b
# is dense and degrades harder than the MoE model once it spills off GPU
# at this context size. See docs/tuning-results.md ("qwen3.5:9b tuning")
# and modelfiles/qwen3.5__9b-64k-agentic/Modelfile for the measurements.
#
# NOTE: Copilot CLI's BYOK mode is locked to a single model per process —
# see bin/copilot-agentic for why in-session switching isn't possible;
# exit and relaunch with a different script to switch models.
#
# Usage: bin/copilot-agentic-9b [copilot args...]

set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=/dev/null
source "$REPO_ROOT/configs/copilot/copilot-byok-9b-64k-agentic.env"

exec copilot "$@"
